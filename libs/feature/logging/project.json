{
  "projectType": "library",
  "sourceRoot": "libs/feature/logging/src",
  "prefix": "evaluator",
  "targets": {
    "test": {
      "executor": "@nx/vite:test",
      "outputs": [
        "{options.reportsDirectory}"
      ],
      "options": {
        "config": "libs/feature/logging/vite.config.mts",
        "reportsDirectory": "coverage/libs/feature/logging"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/feature/logging/**/*.ts",
          "libs/feature/logging/**/*.html"
        ]
      }
    }
  },
  "tags": [
    "feature logging"
  ],
  "name": "feature-logging"
}
