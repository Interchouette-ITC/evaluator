{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/evaluator-backend/src",
  "projectType": "application",
  "tags": [
    "evaluator-backend"
  ],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "platform": "node",
        "outputPath": "dist/apps/evaluator-backend",
        "format": [
          "cjs"
        ],
        "bundle": true,
        "thirdParty": false,
        "main": "apps/evaluator-backend/src/main.ts",
        "tsConfig": "apps/evaluator-backend/tsconfig.app.json",
        "assets": [
          "apps/evaluator-backend/src/assets"
        ],
        "generatePackageJson": false,
        "external": [
          "@nestjs/microservices",
          "@nestjs/websockets",
          "class-validator",
          "class-transformer"
        ],
        "esbuildOptions": {
          "outExtension": {
            ".js": ".js"
          }
        }
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/evaluator-backend/src/environments/environment.ts",
              "with": "apps/evaluator-backend/src/environments/environment.prod.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "evaluator-backend:build"
      },
      "configurations": {
        "production": {
          "buildTarget": "evaluator-backend:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "apps/evaluator-backend/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": [
        "{options.reportsDirectory}"
      ],
      "options": {
        "config": "apps/evaluator-backend/vite.config.mts",
        "reportsDirectory": "coverage/apps/evaluator-backend"
      }
    }
  },
  "name": "evaluator-backend"
}
