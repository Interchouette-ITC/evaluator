    "crypto": false
  },
  "overrides": {
    "smol-toml": "^1.8.0",
    "multer": "^2.3.0",
    "svgo": "^4.0.3",
    "image-size": "^2.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "puppeteer@25.4.0": true,
    "sqlite3@6.0.1": true,
    "nx@23.2.1": true,
    "less@4.5.1": true,
