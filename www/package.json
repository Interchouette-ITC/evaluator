{
  "name": "evaluator",
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "ng": "NX_NO_CLOUD=true nx",
    "start": "npm run start:fe & npm run start:api & npm run start:node",
    "start:dev": "NX_NO_CLOUD=true nx run-many --target=serve --projects=evaluator-backend,evaluator",
    "start:api": "NX_NO_CLOUD=true nx serve evaluator-backend",
    "start:fe": "NX_NO_CLOUD=true nx serve evaluator",
    "start:node": "NX_NO_CLOUD=true nx run evaluator:serve-node",
    "build:angular": "NX_NO_CLOUD=true nx run-many --target=build --projects=evaluator,evaluator-backend --parallel=true",
    "build": "NX_NO_CLOUD=true nx build evaluator && NX_NO_CLOUD=true nx run evaluator:build-node && NX_NO_CLOUD=true nx run evaluator-backend:build",
    "build:node": "NX_NO_CLOUD=true nx run evaluator:build-node",
    "serve:node": "node dist/evaluator/server/server.js",
    "serve": "node dist/apps/evaluator-backend/main.js & node dist/evaluator/server/server.js",
    "test": "NX_NO_CLOUD=true nx run-many -t test --all"
  },
  "private": true,
  "puppeteer": {
    "skipDownload": true
  },
  "dependencies": {
    "@angular/animations": "22.1.0",
    "@angular/common": "22.1.0",
    "@angular/compiler": "22.1.0",
    "@angular/core": "22.1.0",
