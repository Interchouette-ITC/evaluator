    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "nx": "^23.2.1",
    "prettier": "^3.9.6",
    "ts-node": "10.9.2",
    "typescript": "~6.0.3",
