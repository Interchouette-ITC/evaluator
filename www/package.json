    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nx/angular": "^23.2.1",
    "@nx/jest": "^23.2.1",
    "@nx/module-federation": "^23.2.1",
    "@nx/rspack": "^23.2.1",
    "@nx/vitest": "^23.2.1",
    "@nx/webpack": "^23.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-basic-auth": "^1.2.1",
    "highlight.js": "^11.11.1",
    "http-proxy-middleware": "^4.2.0",
    "jquery": "4.0.0",
    "js-beautify": "^2.0.3",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.62.1",
