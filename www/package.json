    "@angular-eslint/eslint-plugin": "~22.6.0",
    "@angular-eslint/eslint-plugin-template": "~22.6.0",
    "@angular-eslint/template-parser": "~22.6.0",
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@angular/language-service": "22.2.5",
    "@nestjs/schematics": "^11",
    "@nestjs/testing": "^11",
    "@nx/esbuild": "24.0.5",
    "@nx/eslint": "24.0.5",
    "@nx/eslint-plugin": "24.0.5",
    "@nx/js": "24.0.5",
    "@nx/nest": "24.0.5",
    "@nx/node": "24.0.5",
    "@nx/vite": "24.0.5",
    "@nx/web": "24.0.5",
    "@nx/workspace": "24.0.5",
    "@types/express": "^5.0.6",
    "@types/jquery": "^4.0.1",
    "@types/js-beautify": "^1.14.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "~10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "nx": "24.0.5",
    "prettier": "^3.9.10",
    "ts-node": "10.9.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.7",
    "vitest": "5.1.0",
    "@nx/angular": "24.0.5",
    "@nx/jest": "24.0.5",
    "@nx/rspack": "24.0.5",
    "@nx/vitest": "24.0.5",
    "@nx/webpack": "24.0.5"
  },
  "browser": {
    "crypto": false
  },
  "overrides": {
    "undici": "8.12.4",
    "glob": "14.0.2",
    "minimatch": "11.0.5",
    "nx": {
      "minimatch": "10.2.5"
    },
    "@nx/devkit": {
      "minimatch": "10.2.5"
    },
    "@nx/jest": {
      "minimatch": "10.2.5"
    }
  },
  "allowScripts": {
    "sqlite3@6.0.1": true,
    "less@4.5.1": true,
    "less@4.8.1": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.6": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true,
    "nx@24.0.5": true,
    "puppeteer@25.17.0": true,
    "msgpackr-extract@3.0.7": true
  }
}
