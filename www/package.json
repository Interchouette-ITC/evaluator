    "@angular/language-service": "22.1.0",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@nx/esbuild": "^23.2.1",
    "@nx/eslint": "^23.2.1",
    "@nx/eslint-plugin": "^23.2.1",
    "@nx/js": "^23.2.1",
    "@nx/nest": "^23.2.1",
    "@nx/node": "^23.2.1",
    "@nx/vite": "^23.2.1",
    "@nx/web": "^23.2.1",
    "@nx/workspace": "^23.2.1",
    "@types/express": "^5.0.6",
    "@types/jquery": "^4.0.1",
