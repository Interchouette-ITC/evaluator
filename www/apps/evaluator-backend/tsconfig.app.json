{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "emitDecoratorMetadata": true,
    "target": "ES2022"
  },
  "exclude": ["vite.config.mts", "**/*.spec.ts", "**/*.test.ts"],
  "include": ["**/*.ts"]
}
