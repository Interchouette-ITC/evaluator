  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/evaluator/server",
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "types": ["node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "files": ["server.ts"],
  "include": ["server.ts"]
}
