{
  "projectType": "library",
  "sourceRoot": "libs/util/sqlite/src",
  "prefix": "evaluator",
  "targets": {
    "test": {
      "executor": "@nx/vite:test",
      "outputs": [
        "{options.reportsDirectory}"
      ],
      "options": {
        "config": "libs/util/sqlite/vite.config.mts",
        "reportsDirectory": "coverage/libs/util/sqlite"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/util/sqlite/**/*.ts",
          "libs/util/sqlite/**/*.html"
        ]
      }
    }
  },
  "tags": [
    "util sqlite"
  ],
  "name": "util-sqlite"
}
