          "libs/util/functions/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": [
        "{options.reportsDirectory}"
      ],
      "options": {
        "config": "libs/util/functions/vite.config.mts",
        "reportsDirectory": "coverage/libs/util/functions"
      }
    }
  },
  "tags": [
    "util-functions"
  ],
  "name": "util-functions"
}
