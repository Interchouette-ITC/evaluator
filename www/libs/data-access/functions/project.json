{
  "projectType": "library",
  "sourceRoot": "libs/data-access/functions/src",
  "prefix": "evaluator",
  "targets": {
    "test": {
      "executor": "@nx/vite:test",
      "outputs": [
        "{options.reportsDirectory}"
      ],
      "options": {
        "config": "libs/data-access/functions/vite.config.mts",
        "reportsDirectory": "coverage/libs/data-access/functions"
