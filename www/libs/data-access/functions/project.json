        "lintFilePatterns": [
          "libs/data-access/functions/**/*.ts",
          "libs/data-access/functions/**/*.html"
        ]
      }
    }
  },
  "tags": [
    "data-access-functions"
  ],
  "name": "data-access-functions"
}
