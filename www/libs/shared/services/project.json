{
  "name": "shared-services",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/shared/services/src",
  "prefix": "evaluator",
  "tags": ["shared services"],
  "targets": {
    "test": {
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/libs/shared/services"
      ],
      "options": {
        "config": "libs/shared/services/vite.config.mts",
        "coverage.reportsDirectory": "../../../coverage/libs/shared/services"
      }
    },
    "lint": {
      "options": {
        "args": ["**/*.ts", "**/*.html"]
      }
    }
  }
}
