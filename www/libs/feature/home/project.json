{
  "projectType": "library",
  "sourceRoot": "libs/feature/home/src",
  "prefix": "evaluator",
  "targets": {
    "test": {
      "executor": "@nx/vite:test",
      "outputs": [
        "{options.reportsDirectory}"
      ],
      "options": {
        "config": "libs/feature/home/vite.config.mts",
        "reportsDirectory": "coverage/libs/feature/home"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/feature/home/**/*.ts",
          "libs/feature/home/**/*.html"
        ]
      }
    }
  },
  "tags": [
    "feature-home"
  ],
  "name": "feature-home"
}
