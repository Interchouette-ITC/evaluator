# syntax=docker/dockerfile:1
#
# Legacy Chromium-free CLI + MCP. Prefer the all-in-one docker/Dockerfile.
# Evaluate still needs a gateway (EVALUATOR_URL). Local only: make docker-build-tools

ARG RUST_IMAGE=rust:1.86-bookworm
ARG NODE_IMAGE=node:26-trixie-slim

FROM ${RUST_IMAGE} AS rust-builder
WORKDIR /src
COPY evaluator/ ./
RUN cargo build --release

FROM ${NODE_IMAGE} AS mcp-deps
WORKDIR /mcp
COPY tools/mcp/package.json tools/mcp/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --omit=dev

FROM ${NODE_IMAGE} AS runtime
WORKDIR /app

RUN groupadd --system --gid 1001 app \
  && useradd --system --uid 1001 --gid app --create-home --home-dir /home/app app

COPY --from=rust-builder /src/target/release/evaluator /usr/local/bin/evaluator
COPY --from=mcp-deps /mcp/node_modules /app/mcp/node_modules
COPY tools/mcp/package.json tools/mcp/server.mjs /app/mcp/

ENV EVALUATOR_URL=http://evaluator:4000 \
    NODE_ENV=production

USER app
EXPOSE 8788

# Default: print help; compose overrides for mcp / cli
CMD ["evaluator", "--help"]
