# syntax=docker/dockerfile:1
#
# Chromium-prebaked base for the web runtime. Rebuild infrequently:
#   make docker-build-base
#
# Does not copy host Chromium — only distro packages.

ARG NODE_IMAGE=node:26-trixie-slim

FROM ${NODE_IMAGE}

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
  && apt-get update \
  && apt-get install -y --no-install-recommends \
    chromium \
    fonts-ipafont-gothic \
    fonts-wqy-zenhei \
    fonts-thai-tlwg \
    fonts-kacst-one \
    fonts-freefont-ttf \
    libxss1 \
    ca-certificates \
  && groupadd --system --gid 1001 app \
  && useradd --system --uid 1001 --gid app --create-home --home-dir /home/app app

ENV PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

LABEL org.opencontainers.image.title="evaluator-base" \
      org.opencontainers.image.description="Node 26 + distro Chromium for evaluator web runtime"
